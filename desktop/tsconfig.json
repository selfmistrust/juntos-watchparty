{
  "compilerOptions": {
    "target": "ES2022",
    // `node16` e o modo que substitui o antigo `node10`.
    //
    // O formato do emit continua CommonJS porque `desktop/package.json` nao
    // declara `"type": "module"`: e o `package.json` mais proximo que decide se
    // um `.ts` deste projeto e CommonJS ou ESM, nao o `module` do tsconfig. Trocar
    // o identificador depreitado e nao trocar o formato da saida.
    //
    // A alternativa seria `"ignoreDeprecations": "6.0"`, que e o que o editor
    // sugere. Isso silenciaria o aviso em vez de corrigir, e a opcao deixa de
    // existir no TypeScript 7 — o aviso voltaria, agora como erro, e o
    // `tsc` pararia de rodar.
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": "electron",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": true
  },
  "include": ["electron/**/*.ts"]
}
