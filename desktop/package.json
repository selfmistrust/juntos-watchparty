{
  "name": "juntos-desktop",
  "productName": "Juntos",
  "version": "1.0.1",
  "private": true,
  "author": "Juntos",
  "description": "Juntos Watch Party em desktop — o mesmo app web, num runtime Electron.",
  "main": "dist/main/index.js",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build:electron": "tsc -p tsconfig.json",
    "icon": "node scripts/make-icon.mjs",
    "build": "npm run build:web && npm run build:electron",
    "build:prod": "node scripts/build-web.mjs --prod && npm run build:electron",
    "start": "npm run build && electron .",
    "start:fast": "npm run build:electron && electron .",
    "dist": "npm run build:prod && electron-builder --win --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.5.3"
  }
}
