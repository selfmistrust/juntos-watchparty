# Copie para `.env.local` e ajuste. O `.env.local` NÃO é versionado.
#
#   cp .env.example .env.local
#
# Por que não versionar: este arquivo é lido pelo Next durante o *build*, não
# só em desenvolvimento, e o valor de `NEXT_PUBLIC_SERVER_URL` fica embutido no
# bundle. Com o arquivo no Git, um `npm run build` sem a variável configurada no
# painel da Vercel publicava um site apontando para `localhost` — que não
# funciona para mais ninguém. Foi exatamente o que aconteceu com o instalador
# do app desktop antes de o `build-web.mjs` passar a checar isso.
#
# Estas variáveis `NEXT_PUBLIC_` vão para o bundle do navegador e não podem
# carregar segredos. As credenciais privadas (Upstash, R2, OAuth do Google)
# ficam em `server/.env`, que também é ignorado. A chave da API do Picker é
# pública por natureza: restrinja-a por origem HTTP e à Google Picker API.

# Endereço do servidor de salas, que o front fala por WebSocket.
#
# Desenvolvimento: o `server` roda em `PORT=4001`, então é `4001`. O default do
# código é `4000`, que é o que estava no `server/.env` antes de ser alinhado —
# por isso o desalinhamento passou despercebido.
#
# Produção: `https://juntos-watchparty.onrender.com`. Na Vercel isto vem do
# painel do projeto, e o que estiver no painel vence o arquivo.
NEXT_PUBLIC_SERVER_URL=http://localhost:4001

# Endereço do site público, usado só pelo link de "Convidar" do app desktop.
#
# A janela do Electron roda em `http://localhost:3210`, que só existe na máquina
# de quem tem o app aberto: sem esta variável, o convite seria um link que
# ninguém consegue abrir. No navegador a variável não é consultada, e o
# `build-web.mjs` em modo `--prod` define os dois valores sozinho, então um
# instalador nunca sai com o que estiver aqui.
NEXT_PUBLIC_SITE_URL=https://juntoswatchparty.vercel.app

# Google Picker: habilite Google Picker API e Google Drive API no mesmo projeto.
# Restrinja a chave por origem (localhost:3001, localhost:3210 e o domínio do
# front) e pela API Google Picker. O número do projeto é o "App ID" do Picker.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=
